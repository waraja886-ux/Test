        "[CONFIG] Food ID = "
        .. Config.FoodFishID
    )


    Log(
        "[CONFIG] Port X = "
        .. Config.Training.startX
        .. " -> "
        .. Config.Training.endX
    )


    Log(
        "[CONFIG] Port Y = "
        .. Config.Training.y
    )


    Log("========================================")


    -- =============================================
    -- MASUK TRAINING WORLD
    -- =============================================

    if not Warp(
        Config.TrainingWorld
    ) then

        Log(
            "[MAIN] Gagal masuk training world."
        )


        ScriptRunning = false


        return

    end


    -- =============================================
    -- LOOP PORT
    -- =============================================

    local x =
        Config.Training.startX


    while true do

        -- =========================================
        -- CEK BATAS
        -- =========================================

        if Config.Training.stepX > 0 then

            if x > Config.Training.endX then

                break

            end

        else

            if x < Config.Training.endX then

                break

            end

        end


        local y =
            Config.Training.y


        Log("")
        Log("========================================")
        Log(
            "[MAIN] PROCESS PORT "
            .. x
            .. ","
            .. y
        )
        Log("========================================")


        local success =
            ProcessPort(
                x,
                y
            )


        if not success then

            Log("")
            Log("========================================")
            Log(
                "[MAIN] STOP DI PORT "
                .. x
                .. ","
                .. y
            )
            Log("========================================")


            ScriptRunning = false


            return

        end


        Log(
            "[MAIN] PORT "
            .. x
            .. ","
            .. y
            .. " SELESAI."
        )


        -- =========================================
        -- PORT BERIKUTNYA
        -- =========================================

        x =
            x + Config.Training.stepX


        Wait(1000)

    end


    -- =============================================
    -- SELESAI
    -- =============================================

    Log("")
    Log("========================================")
    Log("       SEMUA PORT SELESAI")
    Log("========================================")


    ScriptRunning = false

end


-- =========================================================
-- START
-- =========================================================

runThread(
    function()

        Main()

    end
)
