-- =========================================================
-- WAIT FISH DIALOG
-- =========================================================

function WaitFishDialog()

    local startTime =
        os.clock()


    while not FishDialogReceived do

        Wait(100)


        if os.clock() - startTime
           >=
           (
               Config.Delay.dialogTimeout
               / 1000
           ) then

            Log(
                "[DIALOG] Timeout."
            )

            return false

        end

    end


    return true

end


-- =========================================================
-- READ PORT
-- =========================================================

function ReadPort(tx, ty)

    -- Reset data lama
    FishDialogReceived = false

    FishStatus = nil

    FishPortX = nil

    FishPortY = nil


    -- =============================================
    -- WRENCH
    -- =============================================

    if not WrenchPort(
        tx,
        ty
    ) then

        return false

    end


    -- =============================================
    -- TUNGGU DIALOG
    -- =============================================

    if not WaitFishDialog() then

        return false

    end


    -- =============================================
    -- CEK PORT
    -- =============================================

    if FishPortX ~= nil
       and FishPortY ~= nil then


        if FishPortX ~= tx
           or FishPortY ~= ty then

            Log(
                "[DIALOG] Koordinat tidak cocok."
            )


            Log(
                "[DIALOG] Expected="
                .. tx
                .. ","
                .. ty
                .. " | Received="
                .. FishPortX
                .. ","
                .. FishPortY
            )


            return false

        end

    end


    -- =============================================
    -- CEK STATUS
    -- =============================================

    if not FishStatus then

        Log(
            "[STATUS] Tidak diketahui."
        )

        return false

    end


    Log(
        "[STATUS] Final = "
        .. FishStatus
    )


    return true

end


-- =========================================================
-- FEED ONE FISH
-- =========================================================

function FeedOneFish(tx, ty)

    local count =
        InventoryCount(
            Config.FoodFishID
        )


    Log(
        "[FEED] Inventory = "
        .. count
    )


    if count < 1 then

        Log(
            "[FEED] Tidak ada food."
        )

        return false

    end


    -- Reset XP
    FishXPReceived = false


    -- =============================================
    -- DIALOG RETURN
    -- =============================================

    local packet =
        "action|dialog_return\n"
        ..
        "dialog_name|fishgotchitank\n"
        ..
        "tilex|"
        .. tx
        .. "|\n"
        ..
        "tiley|"
        .. ty
        .. "|\n"
        ..
        "feedfish|"
        .. Config.FoodFishID


    Log(
        "[FEED] Kirim feed."
    )


    SendPacket(
        2,
        packet
    )


    -- =============================================
    -- COOLDOWN
    -- =============================================

    Wait(
        Config.Delay.afterFeed
    )


    -- =============================================
    -- WAIT XP
    -- =============================================

    Log(
        "[FEED] Menunggu XP..."
    )


    local startTime =
        os.clock()


    while not FishXPReceived do

        Wait(100)


        if os.clock() - startTime
           >=
           (
               Config.Delay.xpTimeout
               / 1000
           ) then

            Log(
                "[FEED] XP TIMEOUT."
            )


            return false

        end

    end


    Log(
        "[FEED] XP OK."
    )


    Wait(
        Config.Delay.beforeRefresh
    )


    return true

end


-- =========================================================
-- PROCESS ONE PORT
-- =========================================================

function ProcessPort(tx, ty)

    Log("")
    Log("========================================")
    Log(
        "[PORT] MULAI "
        .. tx
        .. ","
        .. ty
    )
    Log("========================================")


    -- =============================================
    -- BACA STATUS AWAL
    -- =============================================

    if not ReadPort(
        tx,
        ty
    ) then

        Log(
            "[PORT] Gagal membaca status."
        )

        return false

    end


    -- =============================================
    -- LOOP SAMPAI CONTENT
    -- =============================================

    while true do

        Log(
            "[PORT] Status = "
            .. tostring(FishStatus)
        )


        -- =========================================
        -- CONTENT
        -- =========================================

        if FishStatus == "Content" then

            Log(
                "[PORT] CONTENT -> SELESAI."
            )


            return true

        end


        -- =========================================
        -- KONDISI BERBAHAYA
        -- =========================================

        if FishStatus == "Moderately Full"
           or FishStatus == "Super Full"
           or FishStatus == "Sick"
           or FishStatus == "Almost Dying"
           or FishStatus == "Dead" then

            Log(
                "[SAFETY] "
                .. FishStatus
                .. " -> STOP."
            )


            return false

        end


        -- =========================================
        -- STATUS HARUS DIKENAL
        -- =========================================

        if FishStatus ~= "Starving"
           and FishStatus ~= "Hungry"
           and FishStatus ~= "Slightly Hungry" then

            Log(
                "[SAFETY] Status tidak dikenal -> STOP."
            )


            return false

        end


        -- =========================================
        -- CEK / AMBIL FOOD
        -- =========================================

        if not TakeOneFood() then

            Log(
                "[PORT] Tidak berhasil mendapatkan food."
            )


            return false

        end


        -- =========================================
        -- KEMBALI TRAINING WORLD
        -- =========================================

        if not Warp(
            Config.TrainingWorld
        ) then

            Log(
                "[PORT] Gagal kembali training world."
            )


            return false

        end


        -- =========================================
        -- KEMBALI KE SEBELAH PORT
        -- =========================================

        local standX =
            tx + Config.StandOffsetX


        local standY =
            ty


        Log(
            "[PORT] Kembali ke posisi "
            .. standX
            .. ","
            .. standY
        )


        if not GoTo(
            standX,
            standY
        ) then

            Log(
                "[PORT] Gagal kembali ke port."
            )


            return false

        end


        -- =========================================
        -- CEK POSISI
        -- =========================================

        local px, py =
            Pos()


        Log(
            "[PORT] Player sekarang = "
            .. px
            .. ","
            .. py
        )


        if math.abs(px - standX) > 1
           or math.abs(py - standY) > 1 then

            Log(
                "[PORT] Posisi tidak sesuai."
            )


            return false

        end


        -- =========================================
        -- FEED
        -- =========================================

        if not FeedOneFish(
            tx,
            ty
        ) then

            Log(
                "[PORT] Feed gagal."
            )


            return false

        end


        -- =========================================
        -- REFRESH STATUS
        -- =========================================

        Log(
            "[PORT] Refresh status..."
        )


        if not ReadPort(
            tx,
            ty
        ) then

            Log(
                "[PORT] Gagal membaca status setelah feed."
            )


            return false

        end

    end

end


